+
+"""SC-only private transport: candidate slots are IID auxiliary draws, NOT top-k."""
+import os
+import numpy as np
+import torch
+
+_generators = {}
+
+def enabled():
+    return os.environ.get("VERL_SC_ENABLED", "0") == "1"
+
+def replace_candidate_slots(logq, sampled, packed):
+    if logq.ndim != 2 or sampled.ndim != 1 or logq.shape[0] != sampled.numel():
+        raise RuntimeError("SC sampler shape mismatch")
+    lp = logq.detach().float()
+    if torch.isnan(lp).any() or torch.isposinf(lp).any():
+        raise RuntimeError("Invalid processed log-probabilities")
+    if not torch.allclose(
+        lp.logsumexp(-1), torch.zeros_like(lp[:, 0]),
+        atol=1e-4, rtol=0,
+    ):
+        raise RuntimeError("SC requires normalized actual sampling log-probs")
+
+    key = str(lp.device)
+    if key not in _generators:
+        generator = torch.Generator(device=lp.device)
+        generator.manual_seed(314159)
+        _generators[key] = generator
+
+    aux = torch.multinomial(
+        lp.exp(), 4, replacement=True, generator=_generators[key]
+    )
+    ids = torch.cat([sampled[:, None].long(), aux], dim=-1)
+    values = lp.gather(-1, ids)
+    if not torch.isfinite(values).all():
+        raise RuntimeError("Auxiliary action outside q support")
+    if not torch.equal(packed.logprob_token_ids[:, 0].long(), sampled.long()):
+        raise RuntimeError("Selected-token alignment mismatch")
+
+    # Preserve selected token and its rank.
+    # Remaining four slots implement the private SC transport protocol.
+    return packed._replace(
+        logprob_token_ids=ids.to(torch.int32),
+        logprobs=values,
+    )
+
+def capture_output(state, core_output):
+    if not enabled():
+        return
+    raw = core_output.new_logprobs
+    tokens = list(core_output.new_token_ids)
+    if raw is None:
+        return
+
+    ids = np.asarray(raw.logprob_token_ids)
+    values = np.asarray(raw.logprobs)
+    if ids.ndim != 2 or ids.shape[1] != 5:
+        return  # Greedy validation follows the ordinary path.
+
+    if ids.shape != values.shape or len(tokens) != ids.shape[0]:
+        raise RuntimeError("SC output rows do not match generated tokens")
+    if ids[:, 0].tolist() != tokens or not np.isfinite(values).all():
+        raise RuntimeError("SC output token/q mismatch")
+
+    if not hasattr(state, "_sc_aux_history"):
+        state._sc_aux_history = []
+        state._sc_aux_logq_history = []
+        state._sc_token_history = []
+
+    state._sc_aux_history.extend(ids[:, 1:].astype(np.int64).tolist())
+    state._sc_aux_logq_history.extend(values[:, 1:].astype(float).tolist())
+    state._sc_token_history.extend(tokens)
+
+def attach_completion(state, completion, delta):
+    if not enabled() or not hasattr(state, "_sc_aux_history"):
+        return completion
+    if delta:
+        raise RuntimeError("SC requires FINAL_ONLY output, not DELTA")
+
+    tokens = list(completion.token_ids)
+    n = len(tokens)
+    if n > len(state._sc_token_history) or state._sc_token_history[:n] != tokens:
+        raise RuntimeError("SC completion/history alignment failure")
+
+    completion.sc_aux_token_ids = state._sc_aux_history[:n]
+    completion.sc_aux_logq = state._sc_aux_logq_history[:n]
+    completion.sc_aux_protocol = "iid_processed_q_k4_v1"
+    return completion
