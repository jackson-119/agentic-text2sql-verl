+"""SC auxiliary token transport for the padded, non-continuous agent path."""
+import math
+import os
+import torch
+
+PROTOCOL = "iid_processed_q_k4_v1"
+K = 4
+
+def enabled():
+    return os.environ.get("VERL_SC_ENABLED") == "1"
+
+def append_generation(agent_data, output, sampling_params, continuous=False):
+    if not enabled():
+        return
+    if "temperature" not in sampling_params:
+        raise RuntimeError("SC requires explicit sampling temperature")
+    if float(sampling_params["temperature"]) <= 1e-5:
+        return
+    if continuous:
+        raise RuntimeError("SC transport does not support continuous-token reconstruction")
+
+    extra = output.extra_fields or {}
+    if extra.get("sc_aux_protocol") != PROTOCOL:
+        raise RuntimeError("Missing or incompatible SC TokenOutput protocol")
+    tokens = list(output.token_ids)
+    ids = extra.get("sc_aux_token_ids")
+    logq = extra.get("sc_aux_logq")
+    if ids is None or logq is None or len(ids) != len(tokens) or len(logq) != len(tokens):
+        raise RuntimeError("SC auxiliary length differs from generated token length")
+
+    clean_ids, clean_q = [], []
+    for row, qr in zip(ids, logq):
+        if len(row) != K or len(qr) != K:
+            raise RuntimeError("SC requires exactly four auxiliary draws per token")
+        if any(isinstance(x, bool) or not isinstance(x, int) or x < 0 for x in row):
+            raise RuntimeError("SC auxiliary IDs must be nonnegative integers")
+        if any(not math.isfinite(float(x)) or float(x) > 1e-4 for x in qr):
+            raise RuntimeError("Invalid auxiliary log-q")
+        clean_ids.append(list(row))
+        clean_q.append([float(x) for x in qr])
+
+    history = getattr(agent_data, "_sc_history", None)
+    if history is None:
+        history = []
+        agent_data._sc_history = history
+    mask = list(agent_data.response_mask)
+    start = len(history)
+    if start > len(mask) or any(mask[start:]):
+        raise RuntimeError("Uncaptured assistant tokens before current generation")
+    history.extend([None] * (len(mask) - start))
+    history.extend(zip(tokens, clean_ids, clean_q))
+
+def finalize(agent_data, output):
+    history = getattr(agent_data, "_sc_history", None)
+    if history is None:
+        return
+    mask = list(output.response_mask)
+    tokens = list(output.response_ids)
+    if len(mask) != len(tokens):
+        raise RuntimeError("SC response/mask length mismatch")
+    if len(history) < len(tokens):
+        tail = mask[len(history):]
+        if any(tail):
+            raise RuntimeError("SC history missing generated tokens")
+        history = history + [None] * len(tail)
+
+    ids, logq = [], []
+    for token, active, entry in zip(tokens, mask, history[:len(tokens)]):
+        if active not in (0, 1):
+            raise RuntimeError("Non-binary response mask")
+        if active:
+            if entry is None or entry[0] != token:
+                raise RuntimeError("SC auxiliary/selected-token alignment mismatch")
+            ids.append(list(entry[1]))
+            logq.append(list(entry[2]))
+        else:
+            if entry is not None:
+                raise RuntimeError("SC generation assigned to observation token")
+            ids.append([-1] * K)
+            logq.append([0.0] * K)
+    output.extra_fields["sc_aux_token_ids"] = ids
+    output.extra_fields["sc_aux_logq"] = logq
+    output.extra_fields["sc_aux_protocol"] = PROTOCOL
+
+def collate(inputs):
+    packed = []
+    for item in inputs:
+        prompt_width = item.prompt_ids.shape[-1]
+        response_width = item.response_ids.shape[-1]
+        device = item.input_ids.device
+        extra = item.extra_fields
+        if extra.get("sc_aux_protocol") != PROTOCOL:
+            raise RuntimeError("Training trajectory missing SC auxiliary data")
+        ids = extra.get("sc_aux_token_ids")
+        if ids is None:
+            raise RuntimeError("Missing SC auxiliary IDs")
+        response_attention = item.attention_mask[0, prompt_width:]
+        n = int(response_attention.sum().item())
+        if len(ids) != n:
+            raise RuntimeError("SC auxiliary length differs from unpadded response")
+        if not bool(response_attention[:n].all()) or bool(response_attention[n:].any()):
+            raise RuntimeError("SC expects right-padded responses")
+        dense = torch.full(
+            (1, prompt_width + response_width, K),
+            -1, dtype=torch.long, device=device,
+        )
+        if n:
+            aux = torch.tensor(ids, dtype=torch.long, device=device)
+            if aux.shape != (n, K):
+                raise RuntimeError("Invalid SC auxiliary matrix shape")
+            dense[0, prompt_width:prompt_width+n] = aux
+        active = torch.zeros_like(item.attention_mask, dtype=torch.bool)
+        active[:, prompt_width:] = item.response_mask.bool()
+        present = dense.ge(0)
+        if not torch.equal(present.all(-1), active) or not torch.equal(present.any(-1), active):
+            raise RuntimeError("SC IDs must cover exactly assistant-token positions")
+        if bool((dense[~active] != -1).any()):
+            raise RuntimeError("SC non-assistant IDs must be -1")
+        packed.append(dense)
+    return torch.cat(packed, dim=0)
